{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetower.dev/agents/schema-v1/risks.schema.json",
  "title": "Agent Risk Surfaces Contract",
  "description": "High-risk repository surfaces with approval and validation expectations.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x_[A-Za-z0-9_]+$": true
  },
  "required": ["schema_version", "reviewed_by", "reviewed_at", "source_files", "surfaces"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "properties": {
        "approval_required": { "type": "boolean" },
        "approval_type": { "enum": ["user", "maintainer", "security", "ops"] },
        "minimum_validation_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(~|/)|(^|/)\\.\\.(/|$)" }
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(~|/).*$" }
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "path_globs": {
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "command_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["id", "category", "risk", "paths", "approval_required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "category": {
          "enum": [
            "ai-llm",
            "audit",
            "auth",
            "billing",
            "ci",
            "crypto",
            "data-deletion",
            "data-export",
            "dependencies",
            "deploy",
            "generated-code",
            "hooks",
            "infra",
            "migrations",
            "network",
            "observability",
            "permissions",
            "pii",
            "process-control",
            "rbac",
            "rls",
            "secrets",
            "tenant-isolation",
            "webhooks",
            "other"
          ]
        },
        "risk": { "enum": ["medium", "high", "critical"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "approval_required": { "type": "boolean" },
        "approval_type": { "enum": ["user", "maintainer", "security", "ops"] },
        "validation_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "safe_read_only_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "review_notes": { "type": "string", "minLength": 1 },
        "forbidden_operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "forbidden_without_approval": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "deprecated": true,
          "description": "Legacy free-text list. Prefer forbidden_operations."
        },
        "safe_alternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
