{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetower.dev/agents/schema-v1/validation.schema.json",
  "title": "Agent Validation Matrix Contract",
  "description": "Touched-path to validation mapping for AI agents.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x_[A-Za-z0-9_]+$": true
  },
  "required": ["schema_version", "reviewed_by", "reviewed_at", "source_files", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "changed_files_mode": {
      "enum": ["staged", "unstaged", "all", "branch_diff"]
    },
    "max_cost_without_user_approval": {
      "enum": ["instant", "low", "medium", "high", "very_high"]
    },
    "reason_required_if_skipped": { "type": "boolean" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "full_suite_triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/fullSuiteTrigger" },
      "uniqueItems": true
    },
    "docs_only": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "properties": {
        "globs": {
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "command_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(~|/)|(^|/)\\.\\.(/|$)" }
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(~|/).*$" }
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "receiptRequirement": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "description": { "type": "string", "minLength": 1 },
        "file_prefixes": {
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "command_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        }
      }
    },
    "fullSuiteTrigger": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["globs", "command_ids"],
      "properties": {
        "globs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "command_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["id", "paths", "risk"],
      "anyOf": [
        { "required": ["required_commands"] },
        { "required": ["manual_review_required"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "description": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "exclude_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "required_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "optional_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "downstream_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "manual_review_required": { "type": "boolean" },
        "changed_files_mode": {
          "enum": ["staged", "unstaged", "all", "branch_diff"]
        },
        "max_cost_without_user_approval": {
          "enum": ["instant", "low", "medium", "high", "very_high"]
        },
        "reason_required_if_skipped": { "type": "boolean" },
        "risk_surface_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleId" },
          "uniqueItems": true
        },
        "boundary_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleId" },
          "uniqueItems": true
        },
        "receipt_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/receiptRequirement" }
        },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "approval_required": { "type": "boolean" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
