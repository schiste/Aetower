{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetower.dev/agents/schema-v1/contracts.schema.json",
  "title": "Agent Invariants Contract",
  "description": "Repository invariants that agents must preserve across API, auth, data, runtime, release, and security changes.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x_[A-Za-z0-9_]+$": true
  },
  "required": ["schema_version", "reviewed_by", "reviewed_at", "source_files", "contracts"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(~|/)|(^|/)\\.\\.(/|$)" }
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(~|/).*$" }
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "fieldShape": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/fieldShape" }
        ]
      }
    },
    "forbiddenOperation": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["id", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "description": { "type": "string", "minLength": 1 },
        "path_globs": {
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x_[A-Za-z0-9_]+$": true
      },
      "required": ["id", "category", "rule", "paths", "severity"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "category": {
          "enum": [
            "api",
            "auth",
            "authorization",
            "database",
            "data-integrity",
            "data-privacy",
            "error-shape",
            "observability",
            "performance",
            "process-control",
            "release",
            "security",
            "storage",
            "tenant-isolation",
            "ui",
            "other"
          ]
        },
        "rule": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["warning", "error", "critical"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glob" },
          "uniqueItems": true
        },
        "source_of_truth": { "$ref": "#/$defs/relativePath" },
        "owner": { "type": "string", "minLength": 1 },
        "forbidden_operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/forbiddenOperation" }
        },
        "required_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/commandId" },
          "uniqueItems": true
        },
        "required_validation_rule_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/ruleId" },
          "uniqueItems": true
        },
        "shape": { "$ref": "#/$defs/fieldShape" },
        "safe_alternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "examples_good": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "examples_bad": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "review_notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
